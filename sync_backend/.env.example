# ------------------------------
# YOLO Sync Backend Environment
# Copy this file to .env and fill values.
# ------------------------------

# Core backend settings
SYNC_DB_PATH=/data/sync.db
SYNC_BACKUP_DIR=/data/backups
SYNC_SESSION_TTL_SECONDS=45
SYNC_BACKUP_RETENTION_DAYS=14
SYNC_MAX_FILE_BYTES=8388608
SYNC_REQUIRE_PROJECT_PASSWORD=0

# Recommended in production: protects /api/admin/bootstrap
SYNC_BOOTSTRAP_TOKEN=change-me-long-random-token

# ------------------------------
# S3 image storage (Cloud mode)
# ------------------------------
# If SYNC_S3_BUCKET is set, image files are stored in S3 under:
#   <SYNC_S3_PREFIX>/<project_id>/<relative_path>
# Example object key:
#   datasets/pokemon/yolo-pokemon/images/IMG_1023.JPG
SYNC_S3_BUCKET=yolo-datasets-pokemon
SYNC_S3_PREFIX=datasets/pokemon
SYNC_S3_REGION=eu-west-3

# AWS credentials for boto3 (option A: env vars)
# For production on AWS, prefer IAM roles instead of static keys.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Optional, only if using temporary credentials
AWS_SESSION_TOKEN=
